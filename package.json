{
	"name": "lite-tabs",
	"version": "1.5.2",
	"description": "A lightweight Obsidian tab panel focused on fast native-tab replacement.",
	"main": "main.js",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"check:versions": "node scripts/check-versions.mjs",
		"test": "node scripts/run-tests.mjs",
		"dev": "node esbuild.config.mjs dev"
	},
	"keywords": [
		"obsidian",
		"tabs"
	],
	"author": "Azona77",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.30",
		"esbuild": "^0.25.0",
		"obsidian": "^1.13.1",
		"tslib": "^2.6.2",
		"typescript": "^5.6.0"
	}
}
